{
    "name": "mrhdolek/symfony-boilerplate-ddd",
    "description": "Symfony boilerplate ddd",
    "keywords": ["symfony", "php", "ddd"],
    "license": "MIT",
    "authors": [
        {
            "name": "Aleksander Kowalski",
            "email": "mrhdolek14@gmail.com",
            "homepage": "https://github.com/MrHDOLEK"
        }
    ],
    "type": "project",
    "minimum-stability": "stable",
    "require": {
        "php": "8.5.*",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "doctrine/doctrine-bundle": "3.3.*",
        "doctrine/doctrine-migrations-bundle": "4.0.*",
        "doctrine/orm": "3.6.*",
        "nelmio/api-doc-bundle": "5.10.*",
        "phpdocumentor/reflection-docblock": "6.0.*",
        "phpstan/phpdoc-parser": "2.3.*",
        "ramsey/uuid": "4.9.*",
        "symfony/asset": "8.1.*",
        "symfony/clock": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/expression-language": "8.1.*",
        "symfony/flex": "2.11.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/property-access": "8.1.*",
        "symfony/property-info": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/serializer": "8.1.*",
        "symfony/translation": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/validator": "8.1.*",
        "symfony/yaml": "8.1.*"
    },
    "require-dev": {
        "behat/behat": "^4.0@alpha",
        "dama/doctrine-test-bundle": "8.6.*",
        "friends-of-behat/symfony-extension": "2.7.*",
        "phpunit/phpunit": "13.2.*",
        "symfony/browser-kit": "8.1.*",
        "symfony/debug-bundle": "8.1.*",
        "symfony/web-profiler-bundle": "8.1.*",
        "zircote/swagger-php": "6.5.*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\Unit\\": "tests/unit/",
            "App\\Tests\\Integration\\": "tests/integration/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "scripts": {
        "cs:fix": "PHP_CS_FIXER_IGNORE_ENV=1 tools/cs-fixer/vendor/bin/php-cs-fixer fix --diff --config codestyle.php",
        "cs:check": "PHP_CS_FIXER_IGNORE_ENV=1 tools/cs-fixer/vendor/bin/php-cs-fixer fix --dry-run --diff --config codestyle.php",
        "phpstan": [
            "php -d memory_limit=600M tools/phpstan/vendor/bin/phpstan analyse -c phpstan.neon"
        ],
        "test:architecture": "tools/deptrac/vendor/bin/deptrac --config-file=deptrac.yaml --formatter=table",
        "tools:install": [
            "@composer install --working-dir=tools/phpstan",
            "@composer install --working-dir=tools/cs-fixer",
            "@composer install --working-dir=tools/deptrac"
        ],
        "tools:update": [
            "@composer update --working-dir=tools/phpstan",
            "@composer update --working-dir=tools/cs-fixer",
            "@composer update --working-dir=tools/deptrac"
        ],
        "migrate": "php bin/console doctrine:migrations:migrate -n",
        "test": "phpunit",
        "behat": "behat -c behat.php -f progress",
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        }
    }
}
